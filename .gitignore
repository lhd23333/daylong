# ── 密钥 ─────────────────────────────────────────────
# 真实密钥只在本机 .env 里，永不提交。提交出去的是 .env.example。
.env

# ── Python ───────────────────────────────────────────
__pycache__/
*.pyc
# 桌面窗口版的隔离环境（pywebview 等）。核心服务器不需要它。
.venv/

# ── 本机数据 ─────────────────────────────────────────
# 用户的日程与状态快照，属于个人数据。
data/

# ── 过程产物 ─────────────────────────────────────────
# dist/ 是打包产物与自验脚本的截图落点，.playwright-cli/ 是浏览器缓存。
# 都不参与交付，删掉也不影响运行。
dist/
.playwright-cli/
screenshots/*.png

# ── 系统 ─────────────────────────────────────────────
.DS_Store
Thumbs.db
