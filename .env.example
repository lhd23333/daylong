# 本项目默认使用本地规则引擎，不需要配置任何密钥即可演示。
# 如果想切换到 AI 模式，复制此文件为 .env 并由你的启动方式加载，或直接设置环境变量。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.minimax.cn/v1
OPENAI_MODEL=MiniMax-M3

# 默认 auto：有 API Key 时尝试调用 AI，失败自动回退本地规则。
# 也可设为 off/local/mock 强制使用本地规则。
MUSIC_COMPANION_AI=auto

# ── 可选的远端音乐生成 ─────────────────────────────────────────
#
# 网页上的音乐默认全部由**本地程序化合成器**现场生成：确定、免费、离线可用。
# 下面这一整段是可选的「换成真·AI 生成的音频」通路，不配也能完整演示。
#
# 选哪一家。留空等于 elevenlabs。
#   elevenlabs —— 一次请求直接返回 mp3，链路最短；需要能访问海外网络。
#   tempolor   —— 天谱乐，中国大陆可直连；异步任务（提交 → 轮询 → 下载）。
MUSIC_PROVIDER=elevenlabs

# 选项 A：ElevenLabs。密钥只放在本机 .env，不要提交。
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL_ID=music_v2_5
ELEVENLABS_TIMEOUT=120

# 选项 B：天谱乐（https://platform.tianpuyue.cn）。纯音乐约 ¥0.3/首，最长 270 秒。
# 开户后在控制台创建 API Key，形如 Tempo-xxxx-3w。注意它的鉴权头是裸 key，
# 不带 Bearer 前缀。
TEMPOLOR_API_KEY=
TEMPOLOR_BASE_URL=https://api.tianpuyue.cn
TEMPOLOR_MODEL=tempolor-latest
# 平台把 callback_url 列为必填，但本应用跑在 127.0.0.1 上收不到回调，所以改用
# 官方的任务状态查询接口轮询取结果。这里仍须填一个你控制的 https 地址（占位
# 即可，不会被真的调用）——不填的话我们会明确报错，而不是替你编一个。
TEMPOLOR_CALLBACK_URL=
TEMPOLOR_TIMEOUT=30
TEMPOLOR_POLL_INTERVAL=2
TEMPOLOR_POLL_TIMEOUT=180
