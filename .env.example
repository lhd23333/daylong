# 本项目默认使用本地规则引擎，不需要配置任何密钥即可演示。
# 如果想切换到 AI 模式，复制此文件为 .env 并由你的启动方式加载，或直接设置环境变量。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.minimax.cn/v1
OPENAI_MODEL=MiniMax-M3

# 默认 auto：有 API Key 时尝试调用 AI，失败自动回退本地规则。
# 也可设为 off/local/mock 强制使用本地规则。
MUSIC_COMPANION_AI=auto

# 可选：AI 音乐生成（ElevenLabs Music API）。密钥只放在本机 .env，不要提交。
# 未配置或请求失败时，网页会自动改用本地 WAV fallback。
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL_ID=music_v2_5
ELEVENLABS_TIMEOUT=120
